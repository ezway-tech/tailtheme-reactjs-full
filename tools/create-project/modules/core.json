  "routes": {
    "homePath": "/app/starter",
    "entries": [
      {
        "id": "starter.home",
        "path": "starter",
        "import": "@/pages/starter/home-page",
        "breadcrumb": "Home",
        "nav": {
          "section": "top",
          "labelKey": "nav.starter.home",
          "fallback": "Home",
          "icon": "Home"
        }
      },
      {
        "id": "starter.form",
        "path": "starter/form",
        "import": "@/pages/starter/form-example-page",
        "breadcrumb": "Form example",
        "nav": {
          "section": "top",
          "labelKey": "nav.starter.form",
          "fallback": "Form example",
          "icon": "FileText"
        }
      }
    ]
  },
  "urls": {
    "starter": {
      "home": "/app/starter",
      "form": "/app/starter/form"
    }
  }
}
